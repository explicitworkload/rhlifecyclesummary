# Primary LLM — any OpenAI-compatible /chat/completions endpoint.
# Tried first; falls back to Azure, then Groq. Leave PRIMARY_API_URL blank to disable.
# PRIMARY_API_KEY is optional for endpoints that don't require auth.
PRIMARY_API_URL=
PRIMARY_MODEL=qwen38-27b
PRIMARY_API_KEY=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-safeguard-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Azure OpenAI
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_OPENAI_ENDPOINT=https://llm-gpt4-lightspeed.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4