# --- LLM backend chain ---
# The advisor tries backends in order; the first one configured and responding wins.
# The dashboard itself works without any of these — only the chat is disabled.
#
# LLM_PRIORITY sets that order. Valid names: primary, azure, groq.
# A name left out of the list is disabled entirely, so "azure,groq" would skip
# the primary endpoint even if PRIMARY_API_URL is set.
LLM_PRIORITY=primary,azure,groq

# Primary — any OpenAI-compatible endpoint (vLLM, Ollama, llama.cpp, MaaS, ...).
# PRIMARY_API_URL must be the FULL path, including /chat/completions.
# Leave it blank to disable and fall straight through to Azure.
# Examples:
#   vLLM / llama.cpp   http://localhost:8000/v1/chat/completions
#   Ollama             http://localhost:11434/v1/chat/completions
# PRIMARY_API_KEY is optional — omit it for endpoints that need no auth.
# The model must support OpenAI-style tool calling, which the advisor relies on.
PRIMARY_API_URL=
PRIMARY_MODEL=qwen38-27b
PRIMARY_API_KEY=

# 2. Azure OpenAI
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4

# 3. Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-safeguard-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
